---
import {ClientRouter} from 'astro:transitions';
import {cn} from "../lib/utils";
import '@/styles/globals.css'

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

import { getAbsoluteUrl, getCanonicalUrl, getRobotsContent, METADATA, SITE, UI, withBasePath } from '@/config';
import { DEFAULT_LANG, getLangFromPath, type Lang } from "@/i18n";

interface Props {
    title?: string;
    scrollSmooth: boolean;
    description?: string;
    tags?: string[];
    author?: string;
    imageOg?: string;
    canonicalURL?: string;
    lang?: Lang;
}

const {
    title,
    description,
    tags = [],
    author,
    scrollSmooth,
    canonicalURL,
    imageOg = SITE.ogImage,
    lang = getLangFromPath(Astro.url.pathname) ?? DEFAULT_LANG,
} = Astro.props;

const resolvedTitle = title ?? METADATA.title.default;
const resolvedDescription = description ?? METADATA.description;
const resolvedAuthor = author ?? SITE.logoText;
const resolvedCanonicalURL = canonicalURL ?? getCanonicalUrl(Astro.url.pathname);
const resolvedOgImage = getAbsoluteUrl(imageOg);
const defaultOgImage = METADATA.openGraph.images[0];
const themePreference = UI.theme;
---

<!doctype html>
<html lang={lang} dir={SITE.textDirection} class={cn({"scroll-smooth": scrollSmooth})}>
<head>
    <meta name="msapplication-TileColor" content="#000000"/>
    <meta name="viewport" content="width=device-width"/>
    <meta charset="UTF-8"/>
    <meta name="generator" content={Astro.generator}/>

    <meta name="title" content={resolvedTitle}/>
    <meta name="description" content={resolvedDescription}/>
    <meta name="keywords" content={tags.join(', ')}/>
    <meta name="author" content={resolvedAuthor}/>
    <meta name="robots" content={getRobotsContent()}/>
    <meta name="theme-color" content="#E9EBEC" media="(prefers-color-scheme: light)"/>
    <meta name="theme-color" content="#0C151D" media="(prefers-color-scheme: dark)"/>
    {SITE.googleSiteVerificationId && (
        <meta name="google-site-verification" content={SITE.googleSiteVerificationId}/>
    )}
    <link rel="sitemap" href={withBasePath("/sitemap-index.xml")}/>
    <link rel="icon" href={withBasePath(SITE.favicon)}/>
    <link rel="canonical" href={resolvedCanonicalURL}/>

    <meta property="og:type" content={METADATA.openGraph.type}/>
    <meta property="og:site_name" content={METADATA.openGraph.site_name}/>
    <meta property="og:title" content={resolvedTitle}/>
    <meta property="og:description" content={resolvedDescription}/>
    <meta property="og:url" content={resolvedCanonicalURL}/>
    <meta property="og:image" content={resolvedOgImage}/>
    {defaultOgImage?.width && <meta property="og:image:width" content={String(defaultOgImage.width)}/>}
    {defaultOgImage?.height && <meta property="og:image:height" content={String(defaultOgImage.height)}/>}
    {defaultOgImage?.alt && <meta property="og:image:alt" content={defaultOgImage.alt}/>}
    <meta property="twitter:card" content={METADATA.twitter.cardType}/>
    <meta property="twitter:url" content={resolvedCanonicalURL}/>
    <meta property="twitter:title" content={resolvedTitle}/>
    <meta property="twitter:description" content={resolvedDescription}/>
    <meta property="twitter:image" content={resolvedOgImage}/>

    <title>{resolvedTitle}</title>
    <script is:inline define:vars={{ themePreference }}>
        (() => {
            const storageKey = "portfolio-theme";
            const root = document.documentElement;
            const lockedTheme = themePreference === "light:only" || themePreference === "dark:only";
            const storedTheme = localStorage.getItem(storageKey);
            const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            const configuredTheme = themePreference === "system"
                ? systemTheme
                : themePreference.replace(":only", "");
            const theme = !lockedTheme && (storedTheme === "light" || storedTheme === "dark")
                ? storedTheme
                : configuredTheme;

            root.classList.toggle("dark", theme === "dark");
            root.style.colorScheme = theme;
        })();
    </script>
    <ClientRouter/>
</head>
<body class="min-h-screen w-full overflow-x-hidden bg-light-theme antialiased text-n700 transition-colors duration-300 dark:bg-dark-theme dark:text-light-theme flex flex-col">
<Navbar/>
<main class="container py-20 md:py-24 flex gap-10 flex-col" role="main" id="top">
    <slot/>
</main>
<Footer/>
</body>
</html>
