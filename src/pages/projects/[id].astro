---
import ProjectDetailView from "@/components/ProjectDetailView.astro";
import { getProjects } from "@/i18n";

export async function getStaticPaths() {
    return getProjects("es").map((project) => ({
        params: { id: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
---

<ProjectDetailView lang="es" project={project} />
