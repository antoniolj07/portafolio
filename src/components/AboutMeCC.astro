---
import JobDetails from "./JobDetails.astro";
import EduDetail from "./EduDetail.astro";
import SkillCard from "./SkillCard.astro";

import {getDictionary, type Lang} from '@/i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const { profile } = getDictionary(lang);
const visibleLanguages = profile.languages.filter((language) => language.show);
---

<div class="relative flex flex-col gap-8 text-n700 dark:text-n200 w-full mt-10">
    <div class="mb-4">
        <p>{profile.aboutMe}</p>
    </div>
    <div class="mb-4">
        <h2 class="text-3xl font-bold mb-4">{profile.experienceTitle}</h2>
        <div class="flex flex-col gap-6">
            {profile.workExperience.map((job) => (
                <JobDetails jobData={job} currentLabel={profile.currentLabel} locale={lang} />
            ))}
        </div>
    </div>
    <div class="mb-4">
        <h2 class="text-3xl font-bold mb-4">{profile.educationTitle}</h2>
        <div class="flex flex-col gap-6">
            {profile.education.map((edu) => (
                <EduDetail eduData={edu} currentLabel={profile.currentLabel} locale={lang} />
            ))}
        </div>
    </div>
    <div class="mb-4">
        <h2 class="text-3xl font-bold mb-4">{profile.technicalSkillsTitle}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {profile.technicalSkills.map((skill) => (
                <SkillCard {...skill} showDescription={true}/>
            ))}
        </div>
    </div>
    <div class="mb-4">
        <h2 class="text-2xl font-bold mb-4">{profile.softSkillsTitle}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {profile.softSkills.map((skill) => (
                <SkillCard {...skill} showDescription={false}/>
            ))}
        </div>
    </div>
    {visibleLanguages.length > 0 && <div class="mb-4">
        <h2 class="text-2xl font-bold mb-4">{profile.languagesTitle}</h2>
        <div class="flex flex-col gap-2">
            {visibleLanguages.map((language) => (
                <p>{language.name} - {language.level}</p>
            ))}
        </div>
    </div>}
</div>
