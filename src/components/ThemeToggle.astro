---
import { UI } from "@/config";

interface Props {
    label: string;
}

const { label } = Astro.props as Props;
const themePreference = UI.theme;
const isThemeLocked = themePreference === "light:only" || themePreference === "dark:only";
---

<button
    type="button"
    data-theme-toggle
    data-theme-preference={themePreference}
    aria-label={label}
    title={label}
    class:list={{
        "inline-flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 bg-white/80 text-n700 shadow-sm transition-colors hover:border-primary-light hover:text-n900 dark:border-white/10 dark:bg-white/[0.04] dark:text-n200 dark:hover:border-primary-dark dark:hover:text-white": true,
        "hidden": isThemeLocked,
    }}
>
    <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M21 12.8A8.5 8.5 0 0 1 11.2 3 7 7 0 1 0 21 12.8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5 5l-1.4-1.4M20.4 20.4 19 19M19 5l1.4-1.4M3.6 20.4 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
    </svg>
</button>

<script>
    function bindThemeToggle() {
        const storageKey = "portfolio-theme";
        const root = document.documentElement;
        const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

        const firstToggle = toggles[0];
        const themePreference = firstToggle?.dataset.themePreference ?? "system";
        const isThemeLocked = themePreference === "light:only" || themePreference === "dark:only";
        const getTheme = () => root.classList.contains("dark") ? "dark" : "light";
        const setTheme = (theme: "light" | "dark") => {
            if (isThemeLocked) return;

            root.classList.toggle("dark", theme === "dark");
            root.style.colorScheme = theme;
            localStorage.setItem(storageKey, theme);
        };

        toggles.forEach((toggle) => {
            toggle.onclick = () => {
                setTheme(getTheme() === "dark" ? "light" : "dark");
            };
        });
    }

    bindThemeToggle();
    document.addEventListener("astro:after-swap", bindThemeToggle);
</script>
