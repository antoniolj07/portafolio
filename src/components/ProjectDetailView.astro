---
import {Icon} from "astro-icon/components";

import Layout from "@/layouts/Layout.astro";
import BackBtn from "@/components/BackBtn.astro";
import BackToTop from "@/components/BackToTop.astro";
import ProjectMediaFrame from "@/components/ProjectMediaFrame.astro";
import { getDictionary, getLocalizedPath, type Lang } from "@/i18n";
import { cn } from "@/lib/utils";
import type { ProjectEntry } from "@/i18n/types";

interface Props {
    lang: Lang;
    project: ProjectEntry;
}

const { lang, project } = Astro.props as Props;
const dict = getDictionary(lang);
const projectPath = getLocalizedPath(lang, "/projects");
---

<Layout
    lang={lang}
    title={`${project.title} | ${dict.site.title}`}
    description={project.summary}
    tags={[...dict.site.tags, ...project.stack]}
    author={dict.site.author}
    scrollSmooth={true}
>
    <>
        <div class="flex justify-center mt-10">
            <BackBtn/>
        </div>

        <section class="flex flex-col gap-8">
            <div class="flex flex-col gap-4 max-w-4xl">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="rounded-full bg-primary-light/15 dark:bg-primary-dark/20 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-n900 dark:text-white">
                        {project.category}
                    </span>
                    {project.placeholder && (
                        <span class="rounded-full border border-neutral-300 dark:border-n700 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-n500 dark:text-n200">
                            {dict.projects.placeholderBadge}
                        </span>
                    )}
                </div>
                <div class="flex items-start gap-4">
                    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-light/15 dark:bg-primary-dark/20 text-n900 dark:text-white shrink-0">
                        <Icon name={project.icon} width={30} height={30} />
                    </div>
                    <div class="flex flex-col gap-3">
                        <h1 class="text-3xl md:text-5xl font-bold">{project.title}</h1>
                        <p class="text-lg leading-8 text-n700 dark:text-n200">{project.summary}</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-[1.15fr_0.85fr] gap-6 items-start">
                <div class="w-full">
                    <ProjectMediaFrame image={project.images[0]} variant="hero" urlLabel={project.externalUrl} />
                </div>
                <div class="rounded-[28px] border border-neutral-200 dark:border-n700 bg-white dark:bg-n700 p-6 flex flex-col gap-4">
                    <div>
                        <p class="text-xs uppercase tracking-[0.2em] text-n500 dark:text-n200">{dict.projects.detailStatusTitle}</p>
                        <p class="mt-2 text-lg font-semibold">{project.status}</p>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.2em] text-n500 dark:text-n200">{dict.projects.detailLocationTitle}</p>
                        <p class="mt-2 text-lg font-semibold">{project.location}</p>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-[0.2em] text-n500 dark:text-n200">{dict.projects.detailStackTitle}</p>
                        <div class="mt-3 flex flex-wrap gap-2">
                            {project.stack.map((item) => (
                                <span class="rounded-full bg-neutral-100 dark:bg-black/30 px-3 py-1 text-sm text-n700 dark:text-n200">{item}</span>
                            ))}
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-3 pt-2">
                        {project.externalUrl && (
                            <a href={project.externalUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full bg-n900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-light dark:bg-white dark:text-n900 dark:hover:bg-primary-dark">
                                {dict.actions.moreInfo}
                                <Icon name="arrow-right-up-line" width={18} height={18} />
                            </a>
                        )}
                        <a href={projectPath} class="inline-flex items-center gap-2 rounded-full border border-neutral-200 px-5 py-3 text-sm font-semibold text-primary-light transition-colors hover:border-primary-light dark:border-white/10 dark:text-primary-dark dark:hover:border-primary-dark">
                            <Icon name="arrow-right-up-line" width={18} height={18} />
                            {dict.actions.backToProjects}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="grid grid-cols-1 xl:grid-cols-[1.15fr_0.85fr] gap-6">
            <article class="rounded-[28px] border border-neutral-200 dark:border-n700 bg-white dark:bg-n700 p-6 md:p-8">
                <h2 class="text-2xl font-bold mb-4">{dict.projects.detailOverviewTitle}</h2>
                <div class="space-y-4 text-n700 dark:text-n200 leading-7">
                    {project.overview.map((paragraph) => (
                        <p>{paragraph}</p>
                    ))}
                </div>
            </article>
            <article class="rounded-[28px] border border-neutral-200 dark:border-n700 bg-white dark:bg-n700 p-6 md:p-8">
                <h2 class="text-2xl font-bold mb-4">{dict.projects.detailHighlightsTitle}</h2>
                <ul class="space-y-4 text-n700 dark:text-n200">
                    {project.highlights.map((highlight) => (
                        <li class="flex gap-3">
                            <span class="mt-2 h-2.5 w-2.5 rounded-full bg-primary-light dark:bg-primary-dark shrink-0"></span>
                            <span class="leading-7">{highlight}</span>
                        </li>
                    ))}
                </ul>
            </article>
        </section>

        <section>
            <div class="mb-4">
                <h2 class="text-2xl font-bold">{dict.projects.detailGalleryTitle}</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                {project.images.map((image) => (
                    <div class={cn(image.frame === "browser" && "md:col-span-2")}>
                        <ProjectMediaFrame image={image} variant="gallery" urlLabel={project.externalUrl} />
                    </div>
                ))}
            </div>
        </section>

        <BackToTop label={dict.actions.backToTop} />
    </>
</Layout>
