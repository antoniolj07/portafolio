---
import ProfileImage from "./ProfileImage.astro";
import Social from "./Social.astro";

import {getDictionary, type Lang} from "@/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const { profile } = getDictionary(lang);
---

<div class="mt-5 flex w-full items-center justify-start" data-reveal="fade-right">
    <div class="flex w-full min-w-0 flex-col items-center gap-5 sm:flex-row sm:gap-6">
        <div class="w-[132px] h-[132px] md:w-[152px] md:h-[152px] shrink-0 rounded-full border-[3px] border-primary-light dark:border-primary-dark p-[3px] flex items-center justify-center">
            <ProfileImage name={profile.name} />
        </div>
        <div class="profile-info flex min-w-0 flex-col gap-2 text-center sm:w-full sm:text-left">
            <div class="info min-w-0">
                <h1 class={'text-xl md:text-2xl lg:text-4xl xl:text-4xl text-n900 dark:text-white'}>{profile.name}</h1>
                <p class={'max-w-full text-sm text-n500 dark:text-n200'}>{profile.profession}</p>
            </div>
            <Social />
        </div>
    </div>
</div>
