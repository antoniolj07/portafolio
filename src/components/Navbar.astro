---
import {Icon} from "astro-icon/components";

import {SITE} from "../config";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getDictionary, getLangFromPath, getLocalizedPath, stripLangFromPath } from "@/i18n";

const pathname = Astro.url.pathname;
const currentLang = getLangFromPath(pathname);
const normalizedPath = stripLangFromPath(pathname);
const dict = getDictionary(currentLang);
---

<nav class="fixed start-0 top-0 z-20 w-full border-b border-neutral-200/70 bg-white/85 backdrop-blur-xl transition-colors dark:border-white/10 dark:bg-n700/85" id="menu">
    <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-4 px-4 py-4">
        <a href={getLocalizedPath(currentLang, "/")} class="flex items-center space-x-3 rtl:space-x-reverse">
            <Icon name={SITE.logo} width={40} height={40}/>
            <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">
                {SITE.logoText}
            </span>
        </a>
        <div class="flex md:order-1 items-center gap-3">
            <LanguageSwitcher />
            <ThemeToggle label={dict.navigation.themeToggleLabel} />
            <button id="btn-menu" data-collapse-toggle="navbar-sticky" type="button"
                    class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                    aria-controls="navbar-sticky" aria-expanded="false">
                <span class="sr-only">{dict.navigation.openMenuLabel}</span>
                <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
                </svg>
            </button>
        </div>
        <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-2" id="navbar-sticky">
            <ul class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-gray-100 rounded-lg md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 dark:border-gray-700">
                {
                    dict.navigation.menu.map((item) => {
                        const href = getLocalizedPath(currentLang, item.path);
                        const isActive = item.path === "/"
                            ? normalizedPath === "/"
                            : normalizedPath === item.path || normalizedPath.startsWith(`${item.path}/`);
                        return (
                            <li>
                                <a
                                    href={href}
                                    class:list={{
                                        ["block py-2 px-3 rounded md:p-0"]: true,
                                        ["active"]: isActive,
                                    }}
                                >
                                    {item.label}
                                </a>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </div>
</nav>

<style>
    .active {
        @apply
        text-light-theme
        bg-n500
        md:text-primary-light
        md:bg-transparent
        dark:text-primary-dark
        dark:bg-dark-theme
        md:dark:text-primary-dark
        md:dark:bg-transparent;
    }
</style>

<script>
    function toggleNav() {
        const btnMenu = document.getElementById('btn-menu');
        const navbar = document.getElementById('navbar-sticky');

        btnMenu?.addEventListener('click', function () {
            navbar?.classList.toggle('hidden');
        });
    }

    toggleNav();
    document.addEventListener("astro:after-swap", toggleNav);
</script>
