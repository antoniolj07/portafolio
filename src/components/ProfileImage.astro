---
import type {ImageMetadata} from 'astro';
import {Image} from 'astro:assets';

import {PROFILE, withBasePath} from '@/config';

interface Props {
    name: string;
}

const { name } = Astro.props as Props;
const profileImage = PROFILE.profileImage;
const isPublicImage = profileImage.startsWith("/");
const publicProfileImage = withBasePath(profileImage);

const assetImagePath = `/src/assets/${profileImage}`;
const assetImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif}');

if (!isPublicImage && !assetImages[assetImagePath]) {
    throw new Error(`"${assetImagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif}"`);
}
---

<div class="w-full h-full rounded-full overflow-hidden">
    {isPublicImage ? (
        <img
            class="block w-full h-full object-cover object-[center_24%]"
            src={publicProfileImage}
            alt={`Foto de perfil de ${name}`}
            loading="eager"
        />
    ) : (
        <Image
            class="block w-full h-full object-cover object-[center_24%]"
            src={assetImages[assetImagePath]()}
            alt={`Foto de perfil de ${name}`}
            loading="eager"
        />
    )}
</div>
