---
import { getDictionary, type Lang } from "@/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const references = getDictionary(lang).home.references;
---

<section id="references" class="mt-12 w-full scroll-mt-24 border-t border-neutral-200 pt-10 dark:border-n700" data-reveal="fade-up">
    <div class="mb-8 max-w-4xl">
        <p class="mb-3 text-sm uppercase tracking-[0.25em] text-n500 dark:text-n200">
            {references.eyebrow}
        </p>
        <h2 class="break-words text-3xl font-bold md:text-4xl">
            {references.title}
        </h2>
        <p class="mt-4 max-w-3xl leading-7 text-n700 dark:text-n200">
            {references.description}
        </p>
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        {references.items.map((reference) => (
            <article class="flex h-full flex-col rounded-lg border border-neutral-200 bg-white p-5 shadow-sm dark:border-n700 dark:bg-black md:p-6">
                <div class="flex items-center gap-4">
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary-light text-sm font-bold text-n700 dark:bg-primary-dark">
                        {reference.initials}
                    </div>
                    <div class="min-w-0">
                        <h3 class="break-words text-xl font-bold text-n700 dark:text-light-theme">
                            {reference.name}
                        </h3>
                        <p class="mt-1 text-sm leading-5 text-n500 dark:text-n200">
                            {reference.context}
                        </p>
                    </div>
                </div>

                <div class="my-5 h-px bg-neutral-200 dark:bg-n700"></div>

                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-n500 dark:text-n200">
                    {references.relationshipLabel}
                </p>
                <p class="mt-2 font-semibold leading-6 text-n700 dark:text-light-theme">
                    {reference.relationship}
                </p>
                <p class="mt-4 flex-1 text-[15px] leading-7 text-n700 dark:text-n200">
                    {reference.description}
                </p>
            </article>
        ))}
    </div>
</section>
