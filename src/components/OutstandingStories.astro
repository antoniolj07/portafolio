---
import { getDictionary, type Lang } from "@/i18n";
import { withBasePath } from "@/config";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const outstanding = getDictionary(lang).home.outstanding;
const stories = outstanding.stories.map((story) => ({
    ...story,
    cover: withBasePath(story.cover),
    items: story.items.map((item) => ({
        ...item,
        src: withBasePath(item.src),
    })),
}));
const labels = {
    close: outstanding.closeLabel,
    next: outstanding.nextLabel,
    previous: outstanding.previousLabel,
    pause: outstanding.pauseLabel,
    play: outstanding.playLabel,
};
---

<div
    class="relative w-full"
    data-outstanding-stories
    data-stories={JSON.stringify(stories)}
    data-labels={JSON.stringify(labels)}
>
    <section aria-label={outstanding.ariaLabel} data-reveal="zoom">
        <div class="overflow-hidden rounded-[30px] border border-neutral-200 bg-white/70 px-4 py-5 shadow-[0_18px_50px_rgba(18,53,36,0.07)] backdrop-blur dark:border-white/10 dark:bg-n700/55 sm:px-6">
            <div class="outstanding-scrollbar flex gap-5 overflow-x-auto pb-1 sm:justify-center">
                {stories.map((story, index) => (
                    <button
                        type="button"
                        class="group flex w-[92px] shrink-0 flex-col items-center gap-3 text-center focus:outline-none"
                        aria-label={`${outstanding.ariaLabel}: ${story.title}`}
                        data-outstanding-story-trigger
                        data-story-index={index}
                    >
                        <span class="relative flex h-[78px] w-[78px] items-center justify-center rounded-full bg-[conic-gradient(from_140deg,#FBD144,#51E0C2,#F4775E,#FBD144)] p-[3px] shadow-[0_12px_35px_rgba(18,53,36,0.18)] transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-105 group-focus-visible:ring-2 group-focus-visible:ring-primary-light group-focus-visible:ring-offset-4 group-focus-visible:ring-offset-light-theme dark:group-focus-visible:ring-primary-dark dark:group-focus-visible:ring-offset-dark-theme md:h-[88px] md:w-[88px]">
                            <span class="relative h-full w-full overflow-hidden rounded-full border-[3px] border-white bg-neutral-100 dark:border-n700 dark:bg-n900">
                                <img
                                    src={story.cover}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                                />
                                <span class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-white/10"></span>
                            </span>
                        </span>
                        <span class="line-clamp-2 text-xs font-semibold leading-4 text-n700 transition-colors group-hover:text-n900 dark:text-n200 dark:group-hover:text-white">
                            {story.title}
                        </span>
                    </button>
                ))}
            </div>
        </div>
    </section>

    <div
        class="fixed inset-0 z-[70] hidden bg-n900/75 px-3 py-3 backdrop-blur-2xl dark:bg-black/85 sm:px-6 sm:py-6"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
        data-outstanding-viewer
    >
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_12%,rgba(251,209,68,0.24),transparent_32%),radial-gradient(circle_at_82%_18%,rgba(81,224,194,0.16),transparent_34%),linear-gradient(180deg,rgba(255,255,255,0.08),transparent_42%)]"></div>

        <div class="relative mx-auto flex h-full w-full max-w-[1120px] items-center justify-center">
            <div class="relative flex h-full max-h-[920px] w-full flex-col overflow-hidden rounded-[34px] border border-white/20 bg-white/95 shadow-[0_30px_120px_rgba(0,0,0,0.46)] dark:bg-n700/95 sm:h-[min(92vh,920px)] lg:max-w-[520px]">
                <div class="relative z-10 flex flex-col gap-3 bg-gradient-to-b from-black/72 via-black/32 to-transparent px-4 pb-10 pt-4 text-white">
                    <div class="flex gap-1.5" data-story-progress></div>
                    <div class="flex items-center justify-between gap-3">
                        <div class="min-w-0">
                            <p class="truncate text-sm font-bold" data-story-title></p>
                            <p class="text-xs text-white/72" data-story-count></p>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <button
                                type="button"
                                class="inline-grid h-10 w-10 place-items-center rounded-full border border-white/25 bg-white/15 p-0 text-white backdrop-blur transition-colors hover:bg-white/25 focus:outline-none focus:ring-2 focus:ring-primary-dark"
                                aria-label={outstanding.pauseLabel}
                                data-story-toggle
                            >
                                <span class="story-icon story-icon-pause" aria-hidden="true" data-story-toggle-icon></span>
                            </button>
                            <button
                                type="button"
                                class="inline-grid h-10 w-10 place-items-center rounded-full border border-white/25 bg-white/15 p-0 text-white backdrop-blur transition-colors hover:bg-white/25 focus:outline-none focus:ring-2 focus:ring-primary-dark"
                                aria-label={outstanding.closeLabel}
                                data-story-close
                            >
                                <span class="story-icon story-icon-close" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                </div>

                <figure class="relative -mt-16 flex min-h-0 flex-1 items-center justify-center bg-black">
                    <img
                        src=""
                        alt=""
                        class="h-full max-h-full w-full object-contain"
                        data-story-image
                    />
                    <button
                        type="button"
                        class="absolute inset-y-0 left-0 w-1/3 cursor-w-resize"
                        aria-label={outstanding.previousLabel}
                        data-story-prev
                    ></button>
                    <button
                        type="button"
                        class="absolute inset-y-0 right-0 w-1/3 cursor-e-resize"
                        aria-label={outstanding.nextLabel}
                        data-story-next
                    ></button>
                </figure>

                <div class="relative z-10 border-t border-white/10 bg-n900/90 px-5 py-4 text-white">
                    <p class="text-sm leading-6 text-white/90" data-story-caption></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .outstanding-scrollbar {
        scrollbar-width: none;
    }

    .outstanding-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .story-icon {
        position: relative;
        display: block;
        width: 20px;
        height: 20px;
    }

    .story-icon::before,
    .story-icon::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        display: block;
        transform-origin: center;
    }

    .story-icon-close::before,
    .story-icon-close::after {
        width: 18px;
        height: 2px;
        border-radius: 999px;
        background: currentColor;
    }

    .story-icon-close::before {
        transform: translate(-50%, -50%) rotate(45deg);
    }

    .story-icon-close::after {
        transform: translate(-50%, -50%) rotate(-45deg);
    }

    .story-icon-pause::before,
    .story-icon-pause::after {
        width: 3px;
        height: 16px;
        border-radius: 999px;
        background: currentColor;
    }

    .story-icon-pause::before {
        transform: translate(-5px, -50%);
    }

    .story-icon-pause::after {
        transform: translate(2px, -50%);
    }

    .story-icon-play::before {
        left: 55%;
        width: 0;
        height: 0;
        border-bottom: 8px solid transparent;
        border-left: 12px solid currentColor;
        border-top: 8px solid transparent;
        transform: translate(-50%, -50%);
    }

    .story-icon-play::after {
        display: none;
    }
</style>

<script>
    type StoryItem = {
        src: string;
        alt: string;
        caption: string;
    };

    type Story = {
        title: string;
        cover: string;
        items: StoryItem[];
    };

    type StoryLabels = {
        close: string;
        next: string;
        previous: string;
        pause: string;
        play: string;
    };

    const storyDuration = 10000;
    const rootSelector = "[data-outstanding-stories]";
    const triggerSelector = "[data-outstanding-story-trigger]";
    const storyWindow = window as Window & typeof globalThis & { __outstandingStoriesBound?: boolean };

    let activeRoot: HTMLElement | null = null;
    let activeStories: Story[] = [];
    let activeLabels: StoryLabels | null = null;
    let storyIndex = 0;
    let itemIndex = 0;
    let startedAt = 0;
    let pausedAt = 0;
    let isPaused = false;
    let frameId = 0;

    const parseJson = <T,>(value: string | undefined, fallback: T): T => {
        if (!value) return fallback;

        try {
            return JSON.parse(value) as T;
        } catch {
            return fallback;
        }
    };

    const getViewer = () => activeRoot?.querySelector<HTMLElement>("[data-outstanding-viewer]") ?? null;
    const getCurrentStory = () => activeStories[storyIndex];
    const getCurrentItem = () => getCurrentStory()?.items[itemIndex];

    const stopProgress = () => {
        if (frameId) {
            cancelAnimationFrame(frameId);
            frameId = 0;
        }
    };

    const setProgress = (percent: number) => {
        const viewer = getViewer();
        const bars = viewer?.querySelectorAll<HTMLElement>("[data-story-progress-bar]");
        bars?.forEach((bar, index) => {
            const value = index < itemIndex ? 1 : index === itemIndex ? percent : 0;
            bar.style.transform = `scaleX(${Math.max(0, Math.min(value, 1))})`;
        });
    };

    const tick = () => {
        if (!activeRoot || isPaused) return;

        const elapsed = performance.now() - startedAt;
        const percent = elapsed / storyDuration;
        setProgress(percent);

        if (percent >= 1) {
            goNext();
            return;
        }

        frameId = requestAnimationFrame(tick);
    };

    const startProgress = () => {
        stopProgress();
        isPaused = false;
        startedAt = performance.now();
        tick();
    };

    const renderProgressBars = () => {
        const viewer = getViewer();
        const progress = viewer?.querySelector<HTMLElement>("[data-story-progress]");
        const story = getCurrentStory();
        if (!progress || !story) return;

        progress.replaceChildren(
            ...story.items.map(() => {
                const track = document.createElement("span");
                const bar = document.createElement("span");

                track.className = "h-1 flex-1 overflow-hidden rounded-full bg-white/30";
                bar.className = "block h-full origin-left scale-x-0 rounded-full bg-white";
                bar.dataset.storyProgressBar = "";
                track.append(bar);
                return track;
            }),
        );
    };

    const updateToggleButton = () => {
        const viewer = getViewer();
        const button = viewer?.querySelector<HTMLButtonElement>("[data-story-toggle]");
        const icon = viewer?.querySelector<HTMLElement>("[data-story-toggle-icon]");
        if (!button || !icon || !activeLabels) return;

        button.setAttribute("aria-label", isPaused ? activeLabels.play : activeLabels.pause);
        icon.classList.toggle("story-icon-pause", !isPaused);
        icon.classList.toggle("story-icon-play", isPaused);
    };

    const renderItem = () => {
        const viewer = getViewer();
        const story = getCurrentStory();
        const item = getCurrentItem();
        if (!viewer || !story || !item) return;

        viewer.querySelector<HTMLElement>("[data-story-title]")!.textContent = story.title;
        viewer.querySelector<HTMLElement>("[data-story-count]")!.textContent = `${itemIndex + 1} / ${story.items.length}`;
        viewer.querySelector<HTMLElement>("[data-story-caption]")!.textContent = item.caption;

        const image = viewer.querySelector<HTMLImageElement>("[data-story-image]");
        if (image) {
            image.src = item.src;
            image.alt = item.alt;
        }

        renderProgressBars();
        setProgress(0);
        updateToggleButton();
        startProgress();
    };

    const closeViewer = () => {
        stopProgress();

        const viewer = getViewer();
        if (viewer) {
            viewer.classList.add("hidden");
            viewer.setAttribute("aria-hidden", "true");
            viewer.querySelector<HTMLImageElement>("[data-story-image]")?.removeAttribute("src");
        }

        document.documentElement.classList.remove("lightbox-open");
        activeRoot = null;
        activeStories = [];
        activeLabels = null;
        storyIndex = 0;
        itemIndex = 0;
        isPaused = false;
    };

    const openViewer = (root: HTMLElement, targetStoryIndex: number) => {
        const stories = parseJson<Story[]>(root.dataset.stories, []);
        const labels = parseJson<StoryLabels | null>(root.dataset.labels, null);
        if (!stories.length || !stories[targetStoryIndex]) return;

        activeRoot = root;
        activeStories = stories;
        activeLabels = labels;
        storyIndex = targetStoryIndex;
        itemIndex = 0;

        const viewer = getViewer();
        if (!viewer) return;

        viewer.classList.remove("hidden");
        viewer.setAttribute("aria-hidden", "false");
        document.documentElement.classList.add("lightbox-open");
        viewer.querySelector<HTMLButtonElement>("[data-story-close]")?.focus();
        renderItem();
    };

    function goNext() {
        const story = getCurrentStory();
        if (!story) return closeViewer();

        if (itemIndex + 1 < story.items.length) {
            itemIndex += 1;
            renderItem();
            return;
        }

        if (storyIndex + 1 < activeStories.length) {
            storyIndex += 1;
            itemIndex = 0;
            renderItem();
            return;
        }

        closeViewer();
    }

    const goPrevious = () => {
        if (!activeRoot) return;

        if (itemIndex > 0) {
            itemIndex -= 1;
            renderItem();
            return;
        }

        if (storyIndex > 0) {
            storyIndex -= 1;
            itemIndex = Math.max(0, activeStories[storyIndex].items.length - 1);
            renderItem();
            return;
        }

        renderItem();
    };

    const togglePlayback = () => {
        if (!activeRoot) return;

        if (isPaused) {
            isPaused = false;
            startedAt += performance.now() - pausedAt;
            updateToggleButton();
            tick();
            return;
        }

        isPaused = true;
        pausedAt = performance.now();
        stopProgress();
        updateToggleButton();
    };

    const bindOutstandingStories = () => {
        if (storyWindow.__outstandingStoriesBound) return;

        document.addEventListener("click", (event) => {
            const target = event.target as HTMLElement | null;
            const trigger = target?.closest<HTMLElement>(triggerSelector);
            const root = trigger?.closest<HTMLElement>(rootSelector);

            if (trigger && root) {
                openViewer(root, Number(trigger.dataset.storyIndex ?? 0));
                return;
            }

            if (!activeRoot) return;

            if (target?.closest("[data-story-close]")) {
                closeViewer();
                return;
            }

            if (target?.closest("[data-story-next]")) {
                goNext();
                return;
            }

            if (target?.closest("[data-story-prev]")) {
                goPrevious();
                return;
            }

            if (target?.closest("[data-story-toggle]")) {
                togglePlayback();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (!activeRoot) return;

            if (event.key === "Escape") closeViewer();
            if (event.key === "ArrowRight") goNext();
            if (event.key === "ArrowLeft") goPrevious();
            if (event.key === " ") {
                event.preventDefault();
                togglePlayback();
            }
        });

        storyWindow.__outstandingStoriesBound = true;
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bindOutstandingStories, { once: true });
    } else {
        bindOutstandingStories();
    }
</script>
