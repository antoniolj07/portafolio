---
import {Icon} from "astro-icon/components";

import ProjectMediaFrame from "@/components/ProjectMediaFrame.astro";
import { cn } from "@/lib/utils";
import type { ProjectEntry } from "@/i18n/types";

interface Props {
    project: ProjectEntry;
    href: string;
    buttonLabel: string;
    placeholderLabel: string;
    featured?: boolean;
}

const { project, href, buttonLabel, placeholderLabel, featured = false } = Astro.props as Props;
---

<article class={cn(
    "group rounded-[28px] border border-neutral-200 bg-white dark:border-n700 dark:bg-n700 overflow-hidden",
    "shadow-[0_12px_40px_rgba(18,53,36,0.06)] transition-transform duration-200 hover:-translate-y-1",
    "grid grid-cols-1 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)]",
    featured && "lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]",
)} data-reveal="fade-up">
    <div class="relative overflow-hidden bg-neutral-100 p-3 dark:bg-black/20 md:p-4 lg:flex lg:items-center">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(18,53,36,0.14),transparent_55%)]"></div>
        <ProjectMediaFrame image={project.images[0]} variant="card" urlLabel={project.externalUrl} class="relative z-0" />
    </div>
    <div class="flex min-w-0 flex-col justify-between gap-5 p-6 md:p-8">
        <div class="flex flex-col gap-4">
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-primary-light/20 text-n900 dark:bg-primary-dark/20 dark:text-white">
                    <Icon name={project.icon} width={26} height={26} />
                </div>
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2 text-sm text-n500 dark:text-n200">
                        <span class="font-semibold uppercase tracking-[0.18em] text-n900 dark:text-white">
                            {project.category}
                        </span>
                        {project.placeholder && (
                            <span class="rounded-full border border-neutral-300 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-n500 dark:border-white/10 dark:text-n200">
                                {placeholderLabel}
                            </span>
                        )}
                    </div>
                    <p class="mt-1 text-sm text-n500 dark:text-n200">{project.location}</p>
                </div>
            </div>
            <div class="flex flex-col gap-3">
                <h3 class="break-words text-2xl font-bold text-n900 dark:text-white">{project.title}</h3>
                <p class="text-base leading-7 text-n700 dark:text-n200">{project.shortDescription}</p>
            </div>
            <ul class="space-y-2 text-sm text-n700 dark:text-n200">
                {project.highlights.slice(0, 2).map((highlight) => (
                    <li class="flex gap-3">
                        <span class="mt-2 h-2 w-2 rounded-full bg-primary-light dark:bg-primary-dark"></span>
                        <span>{highlight}</span>
                    </li>
                ))}
            </ul>
            <div class="flex flex-wrap gap-2">
                {project.stack.slice(0, 4).map((item) => (
                    <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-n700 dark:bg-black/30 dark:text-n200">{item}</span>
                ))}
            </div>
        </div>
        <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-medium text-n500 dark:text-n200">{project.status}</span>
            <a
                href={href}
                class="inline-flex items-center gap-2 rounded-full bg-n900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-light dark:bg-white dark:text-n900 dark:hover:bg-primary-dark"
            >
                {buttonLabel}
                <Icon name="arrow-right-up-line" width={18} height={18} />
            </a>
        </div>
    </div>
</article>
