---
import {Badge} from "./ui/badge";

import {formatDatetime} from "../lib/utils";

interface Job {
    title: string;
    company: string;
    location: string;
    startDate: string;
    endDate?: string;
    description?: string;
    goals: string[];
    currentJob: boolean;
}

interface Props {
    jobData: Job;
    currentLabel: string;
    locale: string;
}

const {jobData, currentLabel, locale} = Astro.props as Props;
const {
    title,
    company,
    location,
    startDate,
    endDate,
    description,
    goals,
    currentJob,
} = jobData;
---

<div class="flex flex-col gap-2" data-reveal="fade-up">
    <h3 class="text-xl font-bold">{title}</h3>
    <div class="flex items-center gap-2 flex-wrap">
        <Badge className="bg-primary-light dark:bg-primary-dark w-fit rounded-md whitespace-nowrap">
            {formatDatetime(startDate, locale)} - {currentJob ? currentLabel : formatDatetime(endDate, locale)}
        </Badge>
        <p class="truncate">{company}</p>
        <span class="text-sm font-bold">/</span>
        <p class="truncate">{location}</p>
    </div>
    {description && <p>{description}</p>}
    <ul style="list-style: disc;" class="pl-5 space-y-2">
        {goals.map((goal: string) => (
                <li>{goal}</li>
        ))}
    </ul>
</div>
