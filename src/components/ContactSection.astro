---
import EmailIcon from "./icons/EmailIcon.astro";

import { PROFILE } from "@/config";
import { getDictionary, type Lang } from "@/i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props as Props;
const contact = getDictionary(lang).home.contact;
const email = PROFILE.contactInfo.email;
---

{email && (
    <section id="contact" class="mt-12 w-full scroll-mt-24 border-t border-neutral-200 pt-10 dark:border-n700" data-reveal="fade-up">
        <div class="grid gap-6 md:grid-cols-[1.15fr_0.85fr] md:items-end">
            <div class="max-w-3xl">
                <p class="mb-3 text-sm uppercase tracking-[0.25em] text-n500 dark:text-n200">
                    {contact.eyebrow}
                </p>
                <h2 class="break-words text-3xl font-bold md:text-4xl">
                    {contact.title}
                </h2>
                <p class="mt-4 text-n700 leading-7 dark:text-n200">
                    {contact.description}
                </p>
            </div>

            <div class="flex flex-col gap-4 md:items-end">
                <div class="w-full rounded-lg border border-neutral-200 bg-white p-5 shadow-sm dark:border-n700 dark:bg-black md:max-w-md">
                    <p class="text-sm font-semibold text-n500 dark:text-n200">
                        {contact.emailLabel}
                    </p>
                    <a
                        class="mt-2 block break-all text-lg font-bold text-n700 transition-colors hover:text-primary-hover-light dark:text-light-theme dark:hover:text-primary-dark"
                        href={`mailto:${email}`}
                    >
                        {email}
                    </a>
                </div>

                <a
                    href={`mailto:${email}`}
                    class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-md bg-primary-light px-5 text-sm font-semibold text-n700 transition-colors hover:bg-primary-hover-light dark:bg-primary-dark dark:hover:bg-primary-hover-dark md:w-auto"
                >
                    <EmailIcon />
                    {contact.buttonLabel}
                </a>

                <p class="text-sm text-n500 dark:text-n200 md:text-right">
                    {contact.availability}
                </p>
            </div>
        </div>
    </section>
)}
