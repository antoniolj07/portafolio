---
import {Badge} from "./ui/badge";

import {formatDatetime} from "../lib/utils";

interface Edu {
    title: string;
    school: string;
    location: string;
    startDate: string;
    endDate?: string;
    description: string;
    currentUni: boolean;
}

interface Props {
    eduData: Edu;
    currentLabel: string;
    locale: string;
}

const {eduData, currentLabel, locale} = Astro.props as Props;
const {
    title,
    school,
    location,
    startDate,
    endDate,
    description,
    currentUni
} = eduData;
---

<div class="flex flex-col gap-2" data-reveal="fade-up">
    <Badge className="bg-primary-light dark:bg-primary-dark w-fit rounded-md">
        {formatDatetime(startDate, locale)} - {currentUni ? currentLabel : formatDatetime(endDate, locale)}
    </Badge>
    <h3 class="text-xl font-bold">{title}</h3>
    <div class="flex gap-2 flex-wrap">
        <p>{school}</p>
        <span>/</span>
        <p>{location}</p>
    </div>
    <p>{description}</p>
</div>
